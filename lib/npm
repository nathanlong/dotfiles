#!/bin/zsh

# Set to run directly via ./lib/npm
# Rerun everytime you reset a global node version via asdf

source $(dirname $0)/utils

e_header "Checking npm..."

# List of global npm packages
# LSPs are now managed by Mason
local packages=(
  'degit'
  'tiddlywiki'
  'typescript'
)

# Install packages globally
npm install -g $packages
